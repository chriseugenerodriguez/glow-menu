{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/menus", "destination": "/collections", "permanent": true },
    { "source": "/shop", "destination": "/collections", "permanent": true },
    { "source": "/custom-menus", "destination": "/contact", "permanent": true },
    { "source": "/my-account", "destination": "/contact", "permanent": false },
    { "source": "/cart", "destination": "/contact", "permanent": false },
    { "source": "/checkout", "destination": "/contact", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
